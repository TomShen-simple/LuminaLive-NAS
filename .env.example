# NAS 的局域网 IP。0.0.0.0 表示监听 NAS 的所有网卡。
BIND_IP=0.0.0.0
HOST_PORT=18780
TZ=Asia/Shanghai

# 使用预构建的 amd64/arm64 镜像。
IMAGE_NAME=s1mpleboy/lumina-live-nas:latest
CONTAINER_NAME=lumina-live

# 相对路径适合命令行 Compose；NAS 图形界面建议改成绝对路径。
CONFIG_DIR=./config
DATA_DIR=./data

# 每 30 分钟重新验证一次。首次启动通常需要 1～5 分钟生成列表。
REFRESH_INTERVAL=1800
STARTUP_DELAY=3
HTTP_TIMEOUT=10
CHANNEL_WORKERS=24
MAX_CANDIDATES_PER_CHANNEL=8
MAX_BANDWIDTH=10000000
HEALTH_START_PERIOD=3m

# 默认拒绝私网/环回上游。若 local.m3u 中使用局域网 IPTV 地址才改为 true。
ALLOW_PRIVATE_UPSTREAMS=false

# 可选：额外远程 M3U，多个地址用英文逗号分隔。
EXTRA_M3U_URLS=

# 少数上游会按 User-Agent 限制访问；一般保持默认即可。
UPSTREAM_USER_AGENT=Mozilla/5.0 (Linux; Android 14; TV) AppleWebKit/537.36 Chrome/126.0 Safari/537.36

MEM_LIMIT=1g
CPU_LIMIT=2.0
PIDS_LIMIT=256
LOG_LEVEL=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# 可选：为 Web 管理写操作设置令牌。留空时仅允许局域网客户端修改。
ADMIN_TOKEN=
