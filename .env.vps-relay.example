IMAGE_NAME=s1mpleboy/lumina-live-nas:latest
TZ=Asia/Shanghai
HOST_PORT=18780

# VPS 地址与反向隧道在 VPS 上的本地端口。
VPS_HOST=161.33.172.156
VPS_SSH_USER=opc
VPS_RELAY_PORT=18782

# 两个值都使用独立的 32 字节以上随机字符串。
MIGU_RELAY_TOKEN=replace-with-a-long-random-token
MIGU_RELAY_SIGNING_SECRET=replace-with-another-long-random-secret

# 极空间 Compose 可直接放入 .env；也可以自行改回只读文件挂载。
VPS_TUNNEL_KEY_B64=base64-of-dedicated-private-key
VPS_KNOWN_HOSTS_B64=base64-of-vps-known-hosts

